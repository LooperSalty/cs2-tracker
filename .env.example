# Copie ce fichier en `.env` et renseigne ta cle.
# Le fichier `.env` est ignore par git : il ne quittera jamais ta machine.

# --- Obligatoire pour lire les profils --------------------------------------
# Cle gratuite : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Optionnel ---------------------------------------------------------------
# Adresse et port de l'API locale.
# CS2T_API_HOST=127.0.0.1
# CS2T_API_PORT=8642

# Chemin force vers CS2, si la detection automatique echoue.
# Racine du jeu ou dossier cfg, les deux fonctionnent.
# CS2T_CS2_PATH=D:\SteamLibrary\steamapps\common\Counter-Strike Global Offensive

# Dossier de donnees (defaut : %LOCALAPPDATA%\CS2Tracker)
# CS2T_DATA_DIR=

# DEBUG | INFO | WARNING | ERROR
# CS2T_LOG_LEVEL=INFO

# Archiver automatiquement les parties suivies en direct.
# CS2T_RECORD_MATCHES=1

# Enregistrer un releve de statistiques a chaque consultation de profil.
# CS2T_AUTO_SNAPSHOT=1
